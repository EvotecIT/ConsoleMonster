<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
        <Title>ConsoleMonster PowerShell Module</Title>
        <Description>Thin PowerShell cmdlets over the ConsoleMonster library: print-once tables, trees, panels and charts, and live dashboards with captured PowerShell streams. Windows PowerShell 5.1 and PowerShell 7.</Description>
        <AssemblyName>ConsoleMonster.PowerShell</AssemblyName>
        <AssemblyTitle>ConsoleMonster PowerShell Module</AssemblyTitle>
        <VersionPrefix>2.1.0</VersionPrefix>
        <AssemblyVersion>2.1.0</AssemblyVersion>
        <FileVersion>2.1.0</FileVersion>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <!-- PowerForge enriches module help from the compiler XML documentation file (XmlDoc2CmdletDoc style). -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- We need to remove PowerShell conflicting libraries as it will break output -->
    <Target Name="RemoveFilesAfterBuild" AfterTargets="Build">
        <Delete Files="$(OutDir)System.Management.Automation.dll" />
        <Delete Files="$(OutDir)System.Management.dll" />
    </Target>

    <ItemGroup>
        <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The website and module share the same copyable gallery sources. -->
        <EmbeddedResource Include="..\Website\examples\gallery\**\*.ps1;..\Website\examples\gallery\**\metadata.json"
                          LogicalName="ConsoleMonster.PowerShell.Gallery.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)"
                          WithCulture="false" />
        <!-- The PowerShell side of Invoke-ConsolePester, kept as a native script. -->
        <EmbeddedResource Include="Pester\PesterAdapter.ps1" LogicalName="ConsoleMonster.PowerShell.Pester.PesterAdapter.ps1" />
        <EmbeddedResource Include="Gallery/DemoCapture.ps1" LogicalName="ConsoleMonster.PowerShell.Gallery.DemoCapture.ps1" />
        <EmbeddedResource Include="Formatting\FormatCommandProxy.ps1" />
        <EmbeddedResource Include="Formatting/NativeProgressProxy.ps1" LogicalName="ConsoleMonster.PowerShell.Formatting.NativeProgressProxy.ps1" />
        <EmbeddedResource Update="Interactive\App\PSAppMessages.resx" LogicalName="ConsoleMonster.PowerShell.Interactive.App.PSAppMessages.resources" />
        <EmbeddedResource Update="Help\HelpMessages.resx" LogicalName="ConsoleMonster.PowerShell.Help.HelpMessages.resources" />
        <EmbeddedResource Include="Formatting\OutDefaultProxy.ps1" />
        <EmbeddedResource Include="Help\HelpProxy.ps1" />
        <EmbeddedResource Include="Formatting\ReadLineOptions.ps1" />
        <EmbeddedResource Include="Formatting\EverydayBuiltInViews.ps1" />
        <EmbeddedResource Include="Formatting\GridViewFallback.ps1;Formatting\GridViewLifecycle.ps1;Formatting\GridViewMessages.txt" />
        <EmbeddedResource Include="Formatting\PromptFunction.ps1" />
        <EmbeddedResource Update="Tails\PSLogTailMessages.resx" LogicalName="ConsoleMonster.PowerShell.Tails.PSLogTailMessages.resources" />
        <EmbeddedResource Update="Markdown\PSMarkdownMessages.resx" LogicalName="ConsoleMonster.PowerShell.Markdown.PSMarkdownMessages.resources" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster\ConsoleMonster.csproj" />
        <ProjectReference Include="../ConsoleMonster.PowerShell.Display/ConsoleMonster.PowerShell.Display.csproj" />
        <ProjectReference Include="..\ConsoleMonster.Generators\ConsoleMonster.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\ConsoleMonster.Markdown\ConsoleMonster.Markdown.csproj" />
        <ProjectReference Include="../ConsoleMonster.Graphics/ConsoleMonster.Graphics.csproj" />
    </ItemGroup>
</Project>
