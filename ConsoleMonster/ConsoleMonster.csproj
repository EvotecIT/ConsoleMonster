<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>ConsoleMonster</Title>
        <Description>
            Terminal UI for .NET and PowerShell with no package dependencies: tables, trees, panels and charts,
            live runs and dashboards with thread-safe updates, menus, prompts and forms, and exports to HTML, SVG
            and text. It detects colour, glyphs and window size, and writes plain lines when output is redirected.
            For .NET 8 and .NET 10, .NET Standard 2.0 and .NET Framework 4.7.2.
        </Description>
        <AssemblyName>ConsoleMonster</AssemblyName>
        <AssemblyTitle>ConsoleMonster</AssemblyTitle>
        <VersionPrefix>2.1.2</VersionPrefix>
        <AssemblyVersion>2.1.2</AssemblyVersion>
        <FileVersion>2.1.2</FileVersion>
        <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <PackageId>ConsoleMonster</PackageId>
        <PackageTags>console;terminal;tui;cli;table;tree;chart;progress;dashboard;live;menu;prompt;ansi;powershell</PackageTags>
        <PackageProjectUrl>https://consolemonster.dev/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/EvotecIT/ConsoleMonster</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>Changes in each release: https://github.com/EvotecIT/ConsoleMonster/blob/master/CHANGELOG.MD</PackageReleaseNotes>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <DebugType>portable</DebugType>
        <NeutralLanguage>en</NeutralLanguage>
        <IsPackable>true</IsPackable>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0' ">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.Markdown</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.Tests</_Parameter1>
        </AssemblyAttribute>
        <InternalsVisibleTo Include="ConsoleMonster.Extensions.Tests" />
        <InternalsVisibleTo Include="ConsoleMonster.TestHost" />
        <InternalsVisibleTo Include="ConsoleMonster.Benchmarks" />
        <InternalsVisibleTo Include="ConsoleMonster.PowerShell.Display" />
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SiteFrames</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.PowerShell</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.PowerShell.Display</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.CLI</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.CLI.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.Graphics</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SiteFrames.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <!-- The README as nuget.org shows it (Markdown images, no HTML), written from README.md by the site tool: SiteFrames readme. -->
        <None Include="README.nuget.md" Pack="true" PackagePath="\README.md" />
        <None Include="..\Website\static\site\icon-192.png" Pack="true" PackagePath="\icon.png" Visible="false" />
    </ItemGroup>

    <!--
        The fluent With/Add methods of every widget are generated at build time from the widgets' public properties and
        compiled into this assembly. The generator is a build-time tool only: it is not referenced at run time and not
        packed, so consumers on any target framework and C# version get ordinary methods.
    -->
    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster.Generators\ConsoleMonster.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Recording/TerminalInputRelay.cs" LogicalName="ConsoleMonster.Demos.TerminalInputRelay.cs" />
        <EmbeddedResource Include="Demos/DemoShell.ps1" LogicalName="ConsoleMonster.Demos.DemoShell.ps1" />
        <EmbeddedResource Include="Recording/Native/macos-terminal-exec" LogicalName="ConsoleMonster.Recording.macos-terminal-exec" WithCulture="false" />
        <EmbeddedResource Include="Export\Assets\player.js;Export\Assets\*.css;Export\Assets\*.svg;Export\Assets\*.html" LogicalName="ConsoleMonster.Export.Assets.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Localization\Labels.*.txt" LogicalName="ConsoleMonster.Localization.%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
</Project>
