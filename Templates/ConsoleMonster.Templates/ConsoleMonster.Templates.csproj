<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>ConsoleMonster.Templates</Title>
        <Description>
            dotnet new templates for ConsoleMonster: "consolemonster" creates a console app with a menu, a status report,
            Microsoft.Extensions.Logging through ConsoleMonster, a generic host with the live console dashboard, and
            native AOT publishing.
        </Description>
        <PackageId>ConsoleMonster.Templates</PackageId>
        <PackageType>Template</PackageType>
        <VersionPrefix>2.0.2</VersionPrefix>
        <AssemblyVersion>2.0.2</AssemblyVersion>
        <FileVersion>2.0.2</FileVersion>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PackageTags>dotnet-new;templates;console;terminal;dashboard;consolemonster</PackageTags>
        <PackageProjectUrl>https://github.com/EvotecIT/ConsoleMonster</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/EvotecIT/ConsoleMonster</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeContentInPack>true</IncludeContentInPack>
        <ContentTargetFolders>content</ContentTargetFolders>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <GalleryDemo Include="readiness-report;fleet-filter;setup-basic;worker-progress;build-steps;live-filter;task-menu;patch-progress;log-tail;welcome-compact;welcome-rich;everyday-formatting;assessment;stress;fleet;setup;pipeline;toolbox;query;parallel-patch;prompt-tour;certificate-expiry;disk-usage;process-monitor;port-matrix;repository-status;backup-runner;tls-verdict">
            <Link>content/ConsoleMonsterApp/gallery/%(Identity)/Program.cs</Link>
            <PackagePath>content/content/ConsoleMonsterApp/gallery/%(Identity)/</PackagePath>
        </GalleryDemo>
        <!-- Pack the website's canonical programs without maintaining template copies. -->
        <Content Include="@(GalleryDemo->'../../Website/examples/gallery/%(Identity)/Program.cs')" />
        <GalleryFluentDemo Include="@(GalleryDemo)">
            <Link>content/ConsoleMonsterApp/gallery/%(Identity)/Program.Fluent.cs</Link>
            <PackagePath>content/content/ConsoleMonsterApp/gallery/%(Identity)/</PackagePath>
        </GalleryFluentDemo>
        <Content Include="@(GalleryFluentDemo->'../../Website/examples/gallery/%(Identity)/Program.Fluent.cs')" />
    </ItemGroup>

    <!-- Stage the same linked content for folder installation with dotnet new install. -->
    <Target Name="PrepareTemplateSource">
        <PropertyGroup>
            <TemplateSourcePath Condition="'$(TemplateSourcePath)' == ''">$(BaseIntermediateOutputPath)template-source/</TemplateSourcePath>
        </PropertyGroup>
        <Copy SourceFiles="@(Content)"
              DestinationFiles="@(Content->'$(TemplateSourcePath)%(Identity)')"
              Condition="'%(Content.Link)' == ''" />
        <Copy SourceFiles="@(Content)"
              DestinationFiles="@(Content->'$(TemplateSourcePath)%(Link)')"
              Condition="'%(Content.Link)' != ''" />
        <Message Importance="high" Text="Install template source: dotnet new install &quot;$(TemplateSourcePath)&quot;" />
    </Target>
</Project>
