{
  "$schema": "http://json.schemastore.org/template",
  "author": "Evotec",
  "classifications": [
    "Console",
    "ConsoleMonster",
    "Terminal"
  ],
  "identity": "ConsoleMonster.Templates.App",
  "groupIdentity": "ConsoleMonster.App",
  "name": "ConsoleMonster console app",
  "description": "A console app with a ConsoleMonster menu and status report, logging through ConsoleMonster, a generic host with the live console dashboard, and native AOT publishing.",
  "shortName": "consolemonster",
  "sourceName": "ConsoleMonsterApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0",
          "description": ".NET 8"
        },
        {
          "choice": "net10.0",
          "description": ".NET 10"
        }
      ],
      "defaultValue": "net8.0",
      "replaces": "TARGET_FRAMEWORK"
    },
    "ConsoleMonsterVersion": {
      "type": "parameter",
      "description": "The ConsoleMonster package version (default: the newest 2.0 release).",
      "datatype": "string",
      "defaultValue": "2.0.*",
      "replaces": "CONSOLEMONSTER_VERSION"
    },
    "NoAot": {
      "type": "parameter",
      "description": "Leaves native AOT publishing off.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "demo": {
      "type": "parameter",
      "description": "Start from a gallery demo instead of the menu and hosted service.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "none",
          "description": "The menu, report and hosted service."
        },
        {
          "choice": "readiness-report"
        },
        {
          "choice": "fleet-filter"
        },
        {
          "choice": "setup-basic"
        },
        {
          "choice": "worker-progress"
        },
        {
          "choice": "build-steps"
        },
        {
          "choice": "live-filter"
        },
        {
          "choice": "task-menu"
        },
        {
          "choice": "patch-progress"
        },
        {
          "choice": "log-tail"
        },
        {
          "choice": "welcome-compact"
        },
        {
          "choice": "welcome-rich"
        },
        {
          "choice": "everyday-formatting"
        },
        {
          "choice": "assessment"
        },
        {
          "choice": "stress"
        },
        {
          "choice": "fleet"
        },
        {
          "choice": "setup"
        },
        {
          "choice": "pipeline"
        },
        {
          "choice": "toolbox"
        },
        {
          "choice": "query"
        },
        {
          "choice": "parallel-patch"
        },
        {
          "choice": "prompt-tour"
        },
        {
          "choice": "certificate-expiry"
        },
        {
          "choice": "disk-usage"
        },
        {
          "choice": "process-monitor"
        },
        {
          "choice": "port-matrix"
        },
        {
          "choice": "repository-status"
        },
        {
          "choice": "backup-runner"
        }
      ],
      "defaultValue": "none"
    }
  },
  "primaryOutputs": [
    {
      "path": "ConsoleMonsterApp.csproj"
    }
  ],
  "postActions": [],
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(demo != \"none\")",
          "exclude": [
            "Program.cs"
          ]
        },
        {
          "condition": "true",
          "exclude": [
            "gallery/**"
          ]
        }
      ]
    },
    {
      "source": "gallery/",
      "target": "./",
      "include": [
        "readiness-report/Program.cs"
      ],
      "copyOnly": [
