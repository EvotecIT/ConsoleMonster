<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConsoleMonsterApp</RootNamespace>
<!--#if (demo != "none") -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DemoStyle Condition="'$(DemoStyle)' == ''">DEMO_STYLE</DemoStyle>
<!--#endif -->
<!--#if (!NoAot) -->
    <!-- dotnet publish -c Release -r win-x64 (or linux-x64, osx-arm64) makes one native executable. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleMonster" Version="CONSOLEMONSTER_VERSION" />
<!--#if (demo == "none") -->
    <PackageReference Include="ConsoleMonster.Extensions.Logging" Version="CONSOLEMONSTER_VERSION" />
    <PackageReference Include="ConsoleMonster.Hosting" Version="CONSOLEMONSTER_VERSION" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
<!--#endif -->
  </ItemGroup>
<!--#if (demo != "none") -->
  <ItemGroup>
    <Compile Include="Program.cs" Condition="'$(DemoStyle)' == 'Initializer'" />
    <Compile Include="Program.Fluent.cs" Condition="'$(DemoStyle)' == 'Fluent'" />
  </ItemGroup>
  <Target Name="ValidateDemoStyle" BeforeTargets="CoreCompile" Condition="'$(DemoStyle)' != 'Initializer' and '$(DemoStyle)' != 'Fluent'">
    <Error Text="DemoStyle must be Initializer or Fluent." />
  </Target>
<!--#endif -->
</Project>
