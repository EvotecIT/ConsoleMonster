<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>2.0.1</VersionPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>ConsoleMonster.Markdown</PackageId>
    <Description>CommonMark and table rendering for ConsoleMonster, powered by OfficeIMO.Markdown.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/EvotecIT/ConsoleMonster</RepositoryUrl>
    <PackageProjectUrl>https://consolemonster.dev</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleMonster\ConsoleMonster.csproj" />
    <PackageReference Include="OfficeIMO.Markdown" Version="3.5.2" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
