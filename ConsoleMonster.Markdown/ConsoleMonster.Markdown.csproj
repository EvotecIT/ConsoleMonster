<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>ConsoleMonster.Markdown</Title>
    <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>2.0.2</VersionPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>ConsoleMonster.Markdown</PackageId>
    <Description>Markdown display and widget, frame and recording export for ConsoleMonster, powered by OfficeIMO.Markdown.</Description>
    <PackageTags>console;terminal;markdown;export;consolemonster</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Changes in each release: https://github.com/EvotecIT/ConsoleMonster/blob/master/CHANGELOG.MD</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/EvotecIT/ConsoleMonster</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://consolemonster.dev/</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ConsoleMonster.Generators/ConsoleMonster.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ConsoleMonster\ConsoleMonster.csproj" />
    <PackageReference Include="OfficeIMO.Markdown" Version="3.5.2" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\Website\static\site\icon-192.png" Pack="true" PackagePath="\icon.png" Visible="false" />
  </ItemGroup>
</Project>
