<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>ConsoleMonster.Examples.Extensions</AssemblyName>
        <AssemblyTitle>ConsoleMonster Extensions Examples</AssemblyTitle>
        <Description>Runnable examples for ConsoleMonster.Extensions.Logging (logging) and ConsoleMonster.Hosting (a generic host with the console dashboard).</Description>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster.Extensions.Logging\ConsoleMonster.Extensions.Logging.csproj" />
        <ProjectReference Include="..\ConsoleMonster.Hosting\ConsoleMonster.Hosting.csproj" />
    </ItemGroup>
</Project>
