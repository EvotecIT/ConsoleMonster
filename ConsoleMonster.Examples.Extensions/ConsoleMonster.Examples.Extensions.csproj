<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>ConsoleMonster.Examples.Extensions</AssemblyName>
        <AssemblyTitle>ConsoleMonster Extensions Examples</AssemblyTitle>
        <Description>Runnable examples for ConsoleMonster.Extensions.Logging (logging), ConsoleMonster.Hosting (a generic host with the console dashboard) and a System.CommandLine tool that writes with ConsoleMonster (cli).</Description>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageReference Include="System.CommandLine" Version="2.0.13" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster.Extensions.Logging\ConsoleMonster.Extensions.Logging.csproj" />
        <ProjectReference Include="..\ConsoleMonster.Hosting\ConsoleMonster.Hosting.csproj" />
        <ProjectReference Include="..\ConsoleMonster.Graphics\ConsoleMonster.Graphics.csproj" />
    </ItemGroup>
</Project>
