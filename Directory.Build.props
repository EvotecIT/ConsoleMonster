<Project>
  <PropertyGroup>
    <!-- Fail builds on any compiler warning to keep the codebase clean (mirrors DnsClientX). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>Evotec</Company>
    <Authors>Przemyslaw Klys</Authors>
    <Copyright>(c) 2011 - 2026 Przemyslaw Klys @ Evotec. All rights reserved.</Copyright>
    <Deterministic>true</Deterministic>
    <!-- Build-time fluent generator (development dependency, never shipped). See PowerForge.Generators. -->
    <PowerForgeGeneratorsVersion>3.0.193</PowerForgeGeneratorsVersion>
    <PowerForgeFluentNaming>Prefixed</PowerForgeFluentNaming>
    <PowerForgeFluentFactory>ConsoleMonster.Ui</PowerForgeFluentFactory>
  </PropertyGroup>
</Project>
