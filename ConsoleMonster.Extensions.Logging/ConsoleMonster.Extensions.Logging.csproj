<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>ConsoleMonster.Extensions.Logging</Title>
        <Description>
            A Microsoft.Extensions.Logging provider for ConsoleMonster: log lines with ConsoleMonster's level tags, colours
            and timestamps, scopes and categories, written into a running dashboard's log region when there is one and as
            plain lines when the output is redirected.
        </Description>
        <AssemblyName>ConsoleMonster.Extensions.Logging</AssemblyName>
        <AssemblyTitle>ConsoleMonster.Extensions.Logging</AssemblyTitle>
        <RootNamespace>ConsoleMonster.Extensions.Logging</RootNamespace>
        <VersionPrefix>2.1.1</VersionPrefix>
        <AssemblyVersion>2.1.1</AssemblyVersion>
        <FileVersion>2.1.1</FileVersion>
        <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <PackageId>ConsoleMonster.Extensions.Logging</PackageId>
        <PackageTags>console;terminal;logging;ilogger;microsoft-extensions-logging;dashboard;consolemonster</PackageTags>
        <PackageProjectUrl>https://consolemonster.dev/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/EvotecIT/ConsoleMonster</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>Changes in each release: https://github.com/EvotecIT/ConsoleMonster/blob/master/CHANGELOG.MD</PackageReleaseNotes>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <DebugType>portable</DebugType>
        <NeutralLanguage>en</NeutralLanguage>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0' ">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster\ConsoleMonster.csproj" />
        <ProjectReference Include="../ConsoleMonster.Generators/ConsoleMonster.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\Website\static\site\icon-192.png" Pack="true" PackagePath="\icon.png" Visible="false" />
    </ItemGroup>
</Project>
