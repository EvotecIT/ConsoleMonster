<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The consolemonster.dev site tool. It renders every visual on the site through ConsoleMonster itself and writes
        HTML frames, replay timelines, SVG thumbnails and page data into Website/. See Website/AGENTS.md.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>SiteFrames</AssemblyName>
        <RootNamespace>SiteFrames</RootNamespace>
        <IsPackable>false</IsPackable>
        <InvariantGlobalization>false</InvariantGlobalization>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SiteFrames.Tests" />
        <None Update="Capture/Read-PowerShellCommands.ps1" CopyToOutputDirectory="PreserveNewest" />
        <ProjectReference Include="..\..\..\ConsoleMonster\ConsoleMonster.csproj" />
        <ProjectReference Include="..\..\..\ConsoleMonster.Markdown\ConsoleMonster.Markdown.csproj" />
        <ProjectReference Include="../../../ConsoleMonster.Graphics/ConsoleMonster.Graphics.csproj" />
        <ProjectReference Include="..\..\..\ConsoleMonster.Examples\ConsoleMonster.Examples.csproj" />
        <!-- Compile hosted examples against the module's API without loading a PowerShell runtime into the renderer. -->
        <ProjectReference Include="../../../ConsoleMonster.PowerShell/ConsoleMonster.PowerShell.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../examples/demos/hosting/Orders.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../examples/demos/logging/Shop.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../TemplateDemo/TemplateDemo.csproj" ReferenceOutputAssembly="false" />
        <!-- Compiles the C# programs the site shows (Website/examples/**/*.cs), so their frames come from running them. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    </ItemGroup>
</Project>
