<Project Sdk="Microsoft.NET.Sdk">
    <!-- Records the site's demo of the dotnet new consolemonster app. It compiles the template's own Program.cs (included,
         not copied) against this repository's projects, and drives its menu with scripted keys. Not packed or shipped. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <StartupObject>TemplateDemo.Demo</StartupObject>
        <RootNamespace>TemplateDemo</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\..\..\Templates\ConsoleMonster.Templates\content\ConsoleMonsterApp\Program.cs" Link="App\Program.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\ConsoleMonster\ConsoleMonster.csproj" />
        <ProjectReference Include="..\..\..\ConsoleMonster.Extensions.Logging\ConsoleMonster.Extensions.Logging.csproj" />
        <ProjectReference Include="..\..\..\ConsoleMonster.Hosting\ConsoleMonster.Hosting.csproj" />
    </ItemGroup>
</Project>