{
  "name": "ConsoleMonster",
  "short_name": "ConsoleMonster",
  "description": "Console rendering for .NET and PowerShell, with no dependencies.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#0d121b",
  "theme_color": "#eceff3",
  "icons": [
    { "src": "/site/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/site/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
