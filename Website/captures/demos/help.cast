[3.057,"o","\u001B[?25l\u001B[1mTest-MailDomain\u001B[22m\r\nChecks the mail records of a domain: MX, SPF, DMARC, DKIM and MTA-STS.\u001B[38;2;96;165;250m\u001B[1m\u001B[6;1HSyntax\u001B[m\r\n  \u001B[1mTest-MailDomain\u001B[22m \u001B[38;2;58;61;69m[\u001B[38;2;192;132;252m-Domain\u001B[38;2;58;61;69m] \u001B[38;2;139;143;154m\u003CString\u003E \u001B[38;2;58;61;69m[[\u001B[38;2;192;132;252m-Selector\u001B[38;2;58;61;69m] \u001B[38;2;139;143;154m\u003CString[]\u003E\u001B[38;2;58;61;69m] [[\u001B[38;2;192;132;252m-Timeout\u001B[38;2;58;61;69m] \u001B[38;2;139;143;154m\u003CTimeSpan\u003E\u001B[38;2;58;61;69m]\u001B[m\r\n\u001B[18X\u001B[38;2;58;61;69m\u001B[18C[\u003CCommonParameters\u003E]\u001B[38;2;96;165;250m\u001B[1m\u001B[10;1HDescription\u001B[m\r\n  Resolves each record, compares it with the recommended settings and returns one result per check.\u001B[38;2;96;165;250m\u001B[1m\u001B[13;1HParameters\u001B[m\r\n  \u001B[38;2;75;80;96m\u256D\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256E\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502 \u001B[m\u001B[1mParameter\u001B[22m \u001B[38;2;75;80;96m\u2502 \u001B[m\u001B[1mType\u001B[22m     \u001B[38;2;75;80;96m\u2502 \u001B[m\u001B[1mRequired\u001B[22m \u001B[38;2;75;80;96m\u2502 \u001B[m\u001B[1mPosition\u001B[22m \u001B[38;2;75;80;96m\u2502 \u001B[m\u001B[1mPipeline\u001B[22m \u001B[38;2;75;80;96m\u2502 \u001B[m\u001B[1mDefault\u001B[22m\u001B[12X\u001B[38;2;75;80;96m\u001B[12C\u2502 \u001B[m\u001B[1mDescription\u001B[22m      \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502 \u001B[38;2;192;132;252m-Domain   \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mString   \u001B[38;2;75;80;96m\u2502 \u001B[myes      \u001B[38;2;75;80;96m\u2502        \u001B[m1 \u001B[38;2;75;80;96m\u2502 \u001B[mByValue  \u001B[38;2;75;80;96m\u2502                    \u2502 \u001B[mThe domain to    \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502                    \u2502 \u001B[mcheck, for       \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502                    \u2502 \u001B[mexample\u001B[10X\u001B[38;2;75;80;96m\u001B[10C\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502                    \u2502 \u001B[mevotec.xyz.      \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502 \u001B[38;2;192;132;252m-Selector \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mString[] \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mno       \u001B[38;2;75;80;96m\u2502        \u001B[m2 \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mno       \u001B[38;2;75;80;96m\u2502 \u001B[m@(\u0027selector1\u0027)     \u001B[38;2;75;80;96m\u2502 \u001B[mThe DKIM\u001B[9X\u001B[38;2;75;80;96m\u001B[9C\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502                    \u2502 \u001B[mselectors to     \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502                    \u2502 \u001B[mlook up.\u001B[9X\u001B[38;2;75;80;96m\u001B[9C\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502 \u001B[38;2;192;132;252m-Timeout  \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mTimeSpan \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mno       \u001B[38;2;75;80;96m\u2502        \u001B[m3 \u001B[38;2;75;80;96m\u2502 \u001B[38;2;139;143;154mno       \u001B[38;2;75;80;96m\u2502 \u001B[m(New-TimeSpan      \u001B[38;2;75;80;96m\u2502 \u001B[mHow long to wait \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502 \u001B[m-Seconds 5)        \u001B[38;2;75;80;96m\u2502 \u001B[mfor each DNS     \u001B[38;2;75;80;96m\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2502           \u2502          \u2502          \u2502          \u2502          \u2502                    \u2502 \u001B[manswer.\u001B[10X\u001B[38;2;75;80;96m\u001B[10C\u2502\u001B[m\r\n  \u001B[38;2;75;80;96m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256F\u001B[m\r\n  \u001B[38;2;139;143;154mCommon parameters: -Debug, -ErrorAction, -ErrorVariable, -InformationAction, -OutVariable,\u001B[m\r\n  \u001B[38;2;139;143;154m-Verbose, -WarningAction and the others (about_CommonParameters).\u001B[38;2;96;165;250m\u001B[1m\u001B[31;1HExamples\u001B[m\r\n  \u001B[1mExample 1\u001B[22m\r\n     \u001B[38;2;45;212;191mTest-MailDomain \u001B[38;2;96;165;250m-Domain \u001B[mevotec.xyz\u001B[35;1H  \u001B[1mExample 2\u001B[22m\r\n     \u001B[38;2;74;222;128m\u0027evotec.xyz\u0027\u001B[38;2;139;143;154m, \u001B[38;2;74;222;128m\u0027evotec.pl\u0027 \u001B[m| \u001B[38;2;45;212;191mTest-MailDomain \u001B[38;2;96;165;250m-Selector \u001B[mselector1\u001B[38;2;139;143;154m, \u001B[mselector2 | \u001B[38;2;45;212;191mFormat-ConsoleTa\u2026\u001B[38;1H\u001B[?25h"]
