[3.200,"o","\u001B[?2026h\u001B[3;1H\u001B[0;1mTest-MailDomain\u001B[4;1H\u001B[0mChecks the mail records of a domain: MX, SPF, DMARC, DKIM and MTA-STS.\u001B[6;1H\u001B[0;1;38;2;96;165;250mSyntax\u001B[7;3H\u001B[0;1mTest-MailDomain\u001B[0m \u001B[0;38;2;58;61;69m[\u001B[0;38;2;192;132;252m-Domain\u001B[0;38;2;58;61;69m]\u001B[0m \u001B[0;38;2;139;143;154m\u003CString\u003E\u001B[0m \u001B[0;38;2;58;61;69m[[\u001B[0;38;2;192;132;252m-Selector\u001B[0;38;2;58;61;69m]\u001B[0m \u001B[0;38;2;139;143;154m\u003CString[]\u003E\u001B[0;38;2;58;61;69m]\u001B[0m \u001B[0;38;2;58;61;69m[[\u001B[0;38;2;192;132;252m-Timeout\u001B[0;38;2;58;61;69m]\u001B[0m \u001B[0;38;2;139;143;154m\u003CTimeSpan\u003E\u001B[0;38;2;58;61;69m]\u001B[8;19H[\u003CCommonParameters\u003E]\u001B[10;1H\u001B[0;1;38;2;96;165;250mDescription\u001B[11;3H\u001B[0mResolves each record, compares it with the recommended settings and returns one result per check.\u001B[13;1H\u001B[0;1;38;2;96;165;250mParameters\u001B[14;3H\u001B[0;38;2;75;80;96m\u256D\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256E\u001B[15;3H\u2502\u001B[0m \u001B[0;1mParameter\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;1mType\u001B[15;26H\u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;1mRequired\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;1mPosition\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;1mPipeline\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;1mDefault\u001B[15;80H\u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;1mDescription\u001B[15;99H\u001B[0;38;2;75;80;96m\u2502\u001B[16;3H\u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001B[17;3H\u2502\u001B[0m \u001B[0;38;2;192;132;252m-Domain\u001B[0m   \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mString\u001B[0m   \u001B[0;38;2;75;80;96m\u2502\u001B[0m yes\u001B[17;37H\u001B[0;38;2;75;80;96m\u2502\u001B[17;46H\u001B[0m1 \u001B[0;38;2;75;80;96m\u2502\u001B[0m ByValue  \u001B[0;38;2;75;80;96m\u2502\u001B[17;80H\u2502\u001B[0m The domain to    \u001B[0;38;2;75;80;96m\u2502\u001B[18;3H\u2502\u001B[18;15H\u2502\u001B[18;26H\u2502\u001B[18;37H\u2502\u001B[18;48H\u2502\u001B[18;59H\u2502\u001B[18;80H\u2502\u001B[0m check, for\u001B[18;99H\u001B[0;38;2;75;80;96m\u2502\u001B[19;3H\u2502\u001B[19;15H\u2502\u001B[19;26H\u2502\u001B[19;37H\u2502\u001B[19;48H\u2502\u001B[19;59H\u2502\u001B[19;80H\u2502\u001B[0m example\u001B[19;99H\u001B[0;38;2;75;80;96m\u2502\u001B[20;3H\u2502\u001B[20;15H\u2502\u001B[20;26H\u2502\u001B[20;37H\u2502\u001B[20;48H\u2502\u001B[20;59H\u2502\u001B[20;80H\u2502\u001B[0m evotec.xyz.\u001B[20;99H\u001B[0;38;2;75;80;96m\u2502\u001B[21;3H\u2502\u001B[0m \u001B[0;38;2;192;132;252m-Selector\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mString[]\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mno\u001B[21;37H\u001B[0;38;2;75;80;96m\u2502\u001B[21;46H\u001B[0m2 \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mno\u001B[21;59H\u001B[0;38;2;75;80;96m\u2502\u001B[0m @(\u0027selector1\u0027)\u001B[21;80H\u001B[0;38;2;75;80;96m\u2502\u001B[0m The DKIM\u001B[21;99H\u001B[0;38;2;75;80;96m\u2502\u001B[22;3H\u2502\u001B[22;15H\u2502\u001B[22;26H\u2502\u001B[22;37H\u2502\u001B[22;48H\u2502\u001B[22;59H\u2502\u001B[22;80H\u2502\u001B[0m selectors to\u001B[22;99H\u001B[0;38;2;75;80;96m\u2502\u001B[23;3H\u2502\u001B[23;15H\u2502\u001B[23;26H\u2502\u001B[23;37H\u2502\u001B[23;48H\u2502\u001B[23;59H\u2502\u001B[23;80H\u2502\u001B[0m look up.\u001B[23;99H\u001B[0;38;2;75;80;96m\u2502\u001B[24;3H\u2502\u001B[0m \u001B[0;38;2;192;132;252m-Timeout\u001B[0m  \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mTimeSpan\u001B[0m \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mno\u001B[24;37H\u001B[0;38;2;75;80;96m\u2502\u001B[24;46H\u001B[0m3 \u001B[0;38;2;75;80;96m\u2502\u001B[0m \u001B[0;38;2;139;143;154mno\u001B[24;59H\u001B[0;38;2;75;80;96m\u2502\u001B[0m (New-TimeSpan\u001B[24;80H\u001B[0;38;2;75;80;96m\u2502\u001B[0m How long to wait \u001B[0;38;2;75;80;96m\u2502\u001B[25;3H\u2502\u001B[25;15H\u2502\u001B[25;26H\u2502\u001B[25;37H\u2502\u001B[25;48H\u2502\u001B[25;59H\u2502\u001B[0m -Seconds 5)\u001B[25;80H\u001B[0;38;2;75;80;96m\u2502\u001B[0m for each DNS\u001B[25;99H\u001B[0;38;2;75;80;96m\u2502\u001B[26;3H\u2502\u001B[26;15H\u2502\u001B[26;26H\u2502\u001B[26;37H\u2502\u001B[26;48H\u2502\u001B[26;59H\u2502\u001B[26;80H\u2502\u001B[0m answer.\u001B[26;99H\u001B[0;38;2;75;80;96m\u2502\u001B[27;3H\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256F\u001B[28;3H\u001B[0;38;2;139;143;154mCommon\u001B[0m \u001B[0;38;2;139;143;154mparameters:\u001B[0m \u001B[0;38;2;139;143;154m-Debug,\u001B[0m \u001B[0;38;2;139;143;154m-ErrorAction,\u001B[0m \u001B[0;38;2;139;143;154m-ErrorVariable,\u001B[0m \u001B[0;38;2;139;143;154m-InformationAction,\u001B[0m \u001B[0;38;2;139;143;154m-OutVariable,\u001B[29;3H-Verbose,\u001B[0m \u001B[0;38;2;139;143;154m-WarningAction\u001B[0m \u001B[0;38;2;139;143;154mand\u001B[0m \u001B[0;38;2;139;143;154mthe\u001B[0m \u001B[0;38;2;139;143;154mothers\u001B[0m \u001B[0;38;2;139;143;154m(about_CommonParameters).\u001B[31;1H\u001B[0;1;38;2;96;165;250mExamples\u001B[32;3H\u001B[0;1mExample 1\u001B[33;6H\u001B[0;38;2;45;212;191mTest-MailDomain\u001B[0m \u001B[0;38;2;96;165;250m-Domain\u001B[0m evotec.xyz\u001B[35;3H\u001B[0;1mExample 2\u001B[36;6H\u001B[0;38;2;74;222;128m\u0027evotec.xyz\u0027\u001B[0;38;2;139;143;154m,\u001B[0m \u001B[0;38;2;74;222;128m\u0027evotec.pl\u0027\u001B[0m | \u001B[0;38;2;45;212;191mTest-MailDomain\u001B[0m \u001B[0;38;2;96;165;250m-Selector\u001B[0m selector1\u001B[0;38;2;139;143;154m,\u001B[0m selector2 | \u001B[0;38;2;45;212;191mShow-ConsoleTable\u001B[0m\u001B[?2026l"]
