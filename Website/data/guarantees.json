      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Stress proves zero drops and actual captured line identities",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/StressRunTests.cs\"><code>StressRun_VerifiesZeroDropsAndCapturedLineIdentitiesAfterDrain</code></a> and the real stress example's delivered-line assertions",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Native Format-Wide fitting",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/Module/Tests/ConsoleMonster.FormatCommands.Tests.ps1\"><code>matches native Wide column fitting for &lt;LayoutName&gt;, including boundary widths and groups</code></a>; direct-host proof in <a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/Module/Tests/Support/Assert-ConcurrencyHost.ps1\"><code>Assert-ConcurrencyHost.ps1</code></a>",
      "runtimes": "PowerShell 5.1 and 7"
