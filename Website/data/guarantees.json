      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Per-thread fragments, CR/LF, and exactly-once tail flushing",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/CaptureWriterConcurrencyTests.cs\"><code>ConcurrentFragments_StayWithTheirProducerUntilNewline</code>, <code>CarriageReturnState_BelongsToTheProducer</code>, <code>Complete_FlushesEveryProducerTailExactlyOnce</code></a>",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
