  "notes": [
    "These tests assert identities, output, ordering, and synchronization. Watchdogs bound a deadlock, not throughput. Core tests run on net472, net8.0 and net10.0; PowerShell tests run on 5.1 and 7."
  ],
  "rows": [
    {
      "guarantee": "Complete concurrent one-shot blocks",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/TerminalBlockConcurrencyTests.cs\"><code>TerminalWrite_ManyProducersKeepEveryMultilineBlockWhole</code></a>",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "One admission per block and preserved final inline line",
      "evidence": "<code>SessionWrites_AdmitWholeMultilineBlocksBeforeAnotherProducer</code>, <code>SessionWrite_PreservesTheFinalInlineLine</code> in the same file",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Exactly-once shutdown fallback to actual OS stdout",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/SessionProcessTests.cs\"><code>StopDuringWritePreparation_PrintsTheWholeFallbackExactlyOnceToNativeStdout</code></a>",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Shutdown fallback cannot split draining blocks; restoration/summary writes flush once",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/TerminalBlockConcurrencyTests.cs\"><code>ShutdownFallback_KeepsItsBlockWholeWhileAnAcceptedBlockIsStillDraining</code>, <code>ShutdownFallback_FromRestorationAndSummaryIsFlushedExactlyOnce</code></a>",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "A late block does not wait for user rendering after Stop or StopTimeout, and flushes once afterward",
      "evidence": "<code>Stopping_LateBlockDoesNotWaitForBlockedWidgetAndFlushesOnce</code> in the same file",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Default output from a frame/summary callback cannot deadlock with a concurrent Snapshot request",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/SessionProcessTests.cs\"><code>RenderCallback_DefaultOutputAndConcurrentSnapshotCannotDeadlock</code></a>, forced frame and summary schedules in isolated processes",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Whole stream lines in apply order, many producers",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/DispatcherConcurrencyTests.cs\"><code>Stream_ManyProducersWriteWholeLinesInExactApplyOrder</code></a>",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Posting proceeds with blocked Apply; every accepted flood event drains",
      "evidence": "<code>Flood_PostingFinishesWhileApplyIsBlocked_ThenEveryAcceptedUpdateDrains</code> in the same file",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Producer order and serialized normal application under stress",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/LiveSessionTests.cs\"><code>ConcurrentProducersPreserveEveryEventAndProducerOrderOnTheRenderThread</code></a>",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "ThrottleLimit bounds ForEachAsync bodies",
      "evidence": "<a href=\"https://github.com/EvotecIT/ConsoleMonster/blob/master/ConsoleMonster.Tests/Live/ThrottleConcurrencyTests.cs\"><code>ForEachAsync_ThrottleBoundsActiveBodiesUnderPressure</code></a>, limits 1, 3, and 8",
      "runtimes": ".NET Framework 4.7.2, .NET 8, .NET 10"
    },
    {
      "guarantee": "Concurrent handles, SummaryBar partial updates, and queued Slot swaps",
