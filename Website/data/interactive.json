    {
      "id": "select",
      "title": "Selection",
      "summary": "A list that filters as you type, with groups, badges, and choices that are unavailable with their reason. The answer comes back as the chosen object, not a string.",
      "keys": "Down Down \"we\" Down Enter",
      "csharp": "SelectPrompt<ToolboxServer> prompt = new SelectPrompt<ToolboxServer>(\"Target server\", ToolboxData.Servers, s => s.Name, s => s.Site) {\n    Description = \"Type to filter; offline servers show why they cannot be picked.\"\n};\nforeach (Choice choice in prompt.Choices) {\n    ToolboxServer server = (ToolboxServer)choice.Value!;\n    choice.Badge = RichText.Plain(server.Role, new RichStyle(ThemeToken.Muted));\n    choice.DisabledReason = server.Offline;\n}\nToolboxServer target = prompt.Show(options);",
      "powershell": "$server = Read-ConsoleSelection 'Target server' -Choices $servers -Display Name -GroupBy Site",
      "player": {
        "url": "/replays/interactive-select.json",
        "w": 100,
        "h": 16,
        "duration": 6900,
        "frames": 6,
        "poster": {
          "w": 100,
          "h": 15,
          "dark": "<span class=\"f60a5fa B c2\">? </span><span class=B>Target server</span>\n<span class=c2>  </span><span class=f8b8f9a>Type to filter; offline servers show why they cannot be picked.</span>\n<span class=c2>  </span><span class=\"f60a5fa c2\"><i class=n>›</i> </span>we\n<span class=c2>  </span><i class=\"g258c f60a5fa k243b5e\">▌</i><span class=\"ff1f5f9 k243b5e c1\"> </span><span class=\"f60a5fa k243b5e B U c2\">WE</span><span class=\"ff1f5f9 k243b5e B c3\">B01</span><span class=\"f8b8f9a k243b5e c10\">  <i class=n>·</i> Warsaw</span><span class=\"ff1f5f9 k243b5e c19\">                   </span><span class=\"f8b8f9a k243b5e c3\">Web</span><span class=\"ff1f5f9 k243b5e\"> </span>\n<span class=c4>    </span><span class=\"f60a5fa B U c2\">WE</span><span class=c3>B11</span><span class=\"f8b8f9a c10\">  <i class=n>·</i> Berlin</span><span class=c19>                   </span><span class=f8b8f9a>Web</span>\n\n<span class=c2>  </span><span class=\"f60a5fa c2\"><i class=n>↑</i><i class=n>↓</i></span><span class=\"f8b8f9a c7\"> move  </span><span class=\"f60a5fa c5\">enter</span><span class=\"f8b8f9a c9\"> select  </span><span class=\"f60a5fa c3\">esc</span><span class=\"f8b8f9a c15\"> clear filter  </span><span class=\"f60a5fa c2\">f1</span><span class=f8b8f9a> keys</span>"
        }
