      "keys": "Down Space Down Down Space Down Down Down Space Enter",
      "csharp": "IReadOnlyList<ToolboxTask> tasks = new MultiSelectPrompt<ToolboxTask>(\"Tasks\", ToolboxData.Tasks, t => t.Name, t => t.Category) {\n    Minimum = 1,\n    Preview = ToolboxData.TaskPreview\n}.Show(options);",
      "csharpFull": null,
      "powershell": "$tasks = $allTasks | Read-ConsoleMultiSelection 'Tasks' -Display Name -GroupBy Category -Minimum 1",
