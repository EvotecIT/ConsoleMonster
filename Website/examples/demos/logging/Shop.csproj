<Project Sdk="Microsoft.NET.Sdk">
    <!-- The logging demo's project: what `dotnet new console -n Shop` plus the packages on the page gives, except that it
         references this repository's project instead of the package. The site records Program.cs built from here. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\ConsoleMonster.Extensions.Logging\ConsoleMonster.Extensions.Logging.csproj" />
    </ItemGroup>
</Project>