{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.pipelinespec.schema.json",
  "cache": true,
  "cachePath": "./.powerforge/pipeline-cache.json",
  "profile": true,
  "profilePath": "./_reports/pipeline-profile.json",
  "steps": [
    {
      "task": "engine-lock",
      "id": "engine-lock-ci",
      "modes": ["ci"],
      "operation": "verify",
      "path": "./.powerforge/engine-lock.json",
      "failOnDrift": true,
      "requireImmutableRef": true,
      "reportPath": "./_reports/engine-lock.json",
      "summaryPath": "./_reports/engine-lock.md"
    },
    {
      "task": "build",
      "id": "build-site",
      "config": "./site.json",
      "out": "./_site",
      "clean": true
    },
    {
      "task": "exec",
      "id": "api-chrome",
      "dependsOn": "build-site",
      "command": "pwsh",
      "argsList": ["-NoProfile", "-File", "./build/Export-ApiChrome.ps1"],
      "workingDirectory": ".",
      "timeoutSeconds": 120
    },
    {
      "task": "dotnet-build",
      "id": "api-build-consolemonster",
      "project": "../ConsoleMonster/ConsoleMonster.csproj",
      "configuration": "Release",
      "framework": "net8.0"
    },
    {
      "task": "apidocs",
      "id": "build-apidocs",
      "dependsOn": ["build-site", "api-chrome", "api-build-consolemonster"],
      "config": "./site.json",
      "assemblies": ["../ConsoleMonster/bin/Release/net8.0/ConsoleMonster.dll"],
      "xmls": ["../ConsoleMonster/bin/Release/net8.0/ConsoleMonster.xml"],
      "out": "./_site/api",
      "title": "ConsoleMonster .NET API reference",
      "baseUrl": "/api",
      "format": "both",
      "template": "docs",
      "css": "/themes/consolemonster/assets/tokens.css,/themes/consolemonster/assets/base.css,/themes/consolemonster/assets/api-base.css,/themes/consolemonster/assets/api.css",
      "sourceRoot": "..",
      "sourceUrl": "https://github.com/EvotecIT/ConsoleMonster/blob/master/{root}/{pathNoRoot}#L{line}",
      "includeNamespace": "ConsoleMonster",
      "quickStartTypes": "Terminal,LiveSession,Table,Panel,DashboardBuilder,ConsoleExporter",
      "relatedContentManifest": "./config/api-related-content.json",
      "coverageReport": "./_reports/apidocs-coverage.json",
      "injectCriticalCss": true,
      "criticalCssPath": "./themes/consolemonster/critical.css",
      "templateDocsIndex": "./themes/consolemonster/apidocs/docs-index.html",
      "templateDocsType": "./themes/consolemonster/apidocs/docs-type.html",
      "headerHtml": "./_temp/chrome/api-header.html",
      "footerHtml": "./_temp/chrome/api-footer.html"
    },
    {
      "task": "apidocs",
      "id": "build-powershell-commands",
      "dependsOn": ["build-site", "api-chrome"],
      "type": "PowerShell",
      "config": "./site.json",
      "help": "../Module/en-US/ConsoleMonster-help.xml",
      "out": "./_site/powershell/commands",
      "baseUrl": "/powershell/commands",
      "title": "ConsoleMonster PowerShell commands",
      "format": "both",
      "template": "docs",
      "css": "/themes/consolemonster/assets/tokens.css,/themes/consolemonster/assets/base.css,/themes/consolemonster/assets/api-base.css,/themes/consolemonster/assets/api.css",
      "injectCriticalCss": true,
      "criticalCssPath": "./themes/consolemonster/critical.css",
      "templateDocsIndex": "./themes/consolemonster/apidocs/docs-index.html",
      "templateDocsType": "./themes/consolemonster/apidocs/docs-type.html",
      "headerHtml": "./_temp/chrome/powershell-commands-header.html",
      "footerHtml": "./_temp/chrome/powershell-commands-footer.html"
    },
    {
      "task": "llms",
      "id": "build-llms",
      "dependsOn": "build-site",
      "siteRoot": "./_site",
      "name": "ConsoleMonster",
      "packageId": "ConsoleMonster",
      "license": "MIT",
      "targets": ".NET Framework 4.7.2, .NET Standard 2.0, .NET 8; Windows PowerShell 5.1 and PowerShell 7"
    },
    {
      "task": "sitemap",
      "id": "sitemap",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "baseUrl": "https://consolemonster.dev",
      "json": true,
      "jsonOut": "./_site/sitemap/index.json",
      "excludePatterns": ["frames/**", "replays/**", "recordings/**", "site/**"]
    },
    {
      "task": "verify",
      "id": "verify-dev",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "skipModes": ["ci"],
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "verify",
      "id": "verify-ci",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "modes": ["ci"],
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "seo-doctor",
      "id": "seo-doctor-ci",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "modes": ["ci"],
      "siteRoot": "./_site",
      "baseline": "./.powerforge/seo-baseline.json",
      "failOnNewIssues": true,
      "checkContentLeaks": true,
      "requireCanonical": true,
      "requireHreflang": false,
      "requireHreflangXDefault": false,
      "reportPath": "./_reports/seo-doctor.json",
      "summaryPath": "./_reports/seo-doctor.md",
      "exclude": "frames/**,replays/**,recordings/**,site/**"
    },
    {
      "task": "audit",
      "id": "audit-ci",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "siteRoot": "./_site",
      "modes": ["ci"],
      "summary": true,
      "sarif": true,
      "baseline": "./.powerforge/audit-baseline.json",
      "failOnNewIssues": true,
      "requiredRoutes": "/404.html,/",
      "requireExplicitChecks": true,
      "checkSeoMeta": false,
      "checkNetworkHints": true,
      "checkRenderBlockingResources": true,
      "checkHeadingOrder": true,
      "checkLinkPurposeConsistency": true,
      "checkMediaEmbeds": true,
      "checkAgentContentSecurity": false,
      "rendered": false,
      "exclude": "frames/**,replays/**,recordings/**,site/**"
    },
    {
      "task": "optimize",
      "id": "optimize-site",
      "dependsOn": ["build-site", "build-llms", "build-apidocs", "build-powershell-commands", "sitemap", "seo-doctor-ci", "verify-ci", "audit-ci"],
      "modes": ["ci"],
      "siteRoot": "./_site",
      "config": "./site.json",
      "criticalCss": "./themes/consolemonster/critical.css",
      "minifyHtml": true,
      "minifyCss": true,
      "minifyJs": true
    },
    {
      "task": "verify",
      "id": "verify-optimized-ci",
      "dependsOn": "optimize-site",
      "config": "./site.json",
      "siteRoot": "./_site",
      "modes": ["ci"],
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "audit",
      "id": "audit-optimized-ci",
      "dependsOn": "optimize-site",
      "siteRoot": "./_site",
      "modes": ["ci"],
      "summary": true,
      "sarif": true,
      "baseline": "./.powerforge/audit-baseline.json",
      "failOnNewIssues": true,
      "requiredRoutes": "/404.html,/",
      "requireExplicitChecks": true,
      "checkSeoMeta": false,
      "checkNetworkHints": true,
      "checkRenderBlockingResources": true,
      "checkHeadingOrder": true,
      "checkLinkPurposeConsistency": true,
      "checkMediaEmbeds": true,
      "checkAgentContentSecurity": false,
      "rendered": false,
      "exclude": "frames/**,replays/**,recordings/**,site/**"
    }
  ]
}