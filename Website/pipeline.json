{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.pipelinespec.schema.json",
  "cache": true,
  "cachePath": "./.powerforge/pipeline-cache.json",
  "profile": true,
  "profilePath": "./_reports/pipeline-profile.json",
  "steps": [
    {
      "task": "exec",
      "id": "test-site-frames",
      "modes": ["ci"],
      "command": "dotnet",
      "argsList": ["test", "tools/SiteFrames.Tests/SiteFrames.Tests.csproj", "-c", "Release", "--nologo", "--logger", "trx;LogFileName=site-frames.trx", "--results-directory", "./_reports/tests"],
      "workingDirectory": ".",
      "timeoutSeconds": 180
    },
    {
      "task": "exec",
      "id": "verify-site-frames",
      "modes": ["ci"],
      "dependsOn": "test-site-frames",
      "command": "pwsh",
      "argsList": ["-NoProfile", "-File", "./build/Test-SiteFrames.ps1"],
      "workingDirectory": ".",
      "timeoutSeconds": 240
    },
    {
      "task": "engine-lock",
      "id": "engine-lock-ci",
      "modes": ["ci"],
      "operation": "verify",
      "path": "./.powerforge/engine-lock.json",
      "failOnDrift": true,
      "requireImmutableRef": false,
      "repository": "EvotecIT/PSPublishModule",
      "ref": "actions-next",
      "channel": "next",
      "reportPath": "./_reports/engine-lock.json",
      "summaryPath": "./_reports/engine-lock.md"
    },
    {
      "task": "build",
      "id": "build-site",
      "dependsOn": "verify-site-frames",
      "config": "./site.json",
      "out": "./_site",
      "clean": true,
      "socialCardsRequired": true
    },
    {
      "task": "exec",
      "id": "api-chrome",
      "dependsOn": "build-site",
      "command": "pwsh",
      "argsList": ["-NoProfile", "-File", "./build/Export-ApiChrome.ps1"],
      "workingDirectory": ".",
      "timeoutSeconds": 120
    },
    {
      "task": "dotnet-build",
      "id": "api-build-consolemonster",
      "project": "../ConsoleMonster/ConsoleMonster.csproj",
      "configuration": "Release",
      "framework": "net8.0"
    },
    {
      "task": "dotnet-build",
      "id": "api-build-markdown",
      "dependsOn": ["api-build-consolemonster"],
      "project": "../ConsoleMonster.Markdown/ConsoleMonster.Markdown.csproj",
      "configuration": "Release",
      "framework": "net8.0"
    },
    {
      "task": "dotnet-build",
      "id": "api-build-graphics",
      "dependsOn": ["api-build-consolemonster"],
      "project": "../ConsoleMonster.Graphics/ConsoleMonster.Graphics.csproj",
      "configuration": "Release",
      "framework": "net8.0"
    },
    {
      "task": "apidocs",
      "id": "build-apidocs",
      "dependsOn": ["build-site", "api-chrome", "api-build-consolemonster", "api-build-markdown", "api-build-graphics"],
      "config": "./site.json",
      "assemblies": ["../ConsoleMonster/bin/Release/net8.0/ConsoleMonster.dll", "../ConsoleMonster.Markdown/bin/Release/net8.0/ConsoleMonster.Markdown.dll", "../ConsoleMonster.Graphics/bin/Release/net8.0/ConsoleMonster.Graphics.dll"],
      "xmls": ["../ConsoleMonster/bin/Release/net8.0/ConsoleMonster.xml", "../ConsoleMonster.Markdown/bin/Release/net8.0/ConsoleMonster.Markdown.xml", "../ConsoleMonster.Graphics/bin/Release/net8.0/ConsoleMonster.Graphics.xml"],
      "out": "./_site/api",
      "title": "ConsoleMonster .NET API reference",
      "baseUrl": "/api",
      "format": "both",
      "template": "docs",
      "socialAutoGenerate": true,
      "socialCardPath": "/site/social/api",
      "socialCardTheme": "cm-api",
      "socialCardTitle": "name",
      "socialCardsRequired": true,
      "css": "/themes/consolemonster/assets/tokens.css,/themes/consolemonster/assets/base.css,/themes/consolemonster/assets/api-base.css,/themes/consolemonster/assets/api.css",
      "sourceRoot": "..",
      "sourceUrl": "https://github.com/EvotecIT/ConsoleMonster/blob/master/{root}/{pathNoRoot}#L{line}",
      "includeNamespace": "ConsoleMonster",
      "quickStartTypes": "Terminal,LiveSession,Table,Panel,DashboardBuilder,ConsoleExporter",
      "relatedContentManifest": "./config/api-related-content.json",
      "coverageReport": "./_reports/apidocs-coverage.json",
      "injectCriticalCss": true,
      "criticalCssPath": "./themes/consolemonster/critical.css",
      "templateDocsIndex": "./themes/consolemonster/apidocs/docs-index.html",
      "templateDocsType": "./themes/consolemonster/apidocs/docs-type.html",
      "headerHtml": "./_temp/chrome/api-header.html",
      "headHtml": "./_temp/chrome/api-head.html",
      "footerHtml": "./_temp/chrome/api-footer.html"
    },
    {
      "task": "apidocs",
      "id": "build-powershell-commands",
      "dependsOn": ["build-site", "api-chrome"],
      "type": "PowerShell",
      "config": "./site.json",
      "help": "../Module/en-US/ConsoleMonster-help.xml",
      "out": "./_site/powershell/commands",
      "baseUrl": "/powershell/commands",
      "title": "ConsoleMonster PowerShell commands",
      "format": "both",
      "template": "docs",
      "socialAutoGenerate": true,
      "socialCardPath": "/site/social/api",
      "socialCardTheme": "cm-api",
      "socialCardTitle": "name",
      "socialCardsRequired": true,
      "css": "/themes/consolemonster/assets/tokens.css,/themes/consolemonster/assets/base.css,/themes/consolemonster/assets/api-base.css,/themes/consolemonster/assets/api.css",
      "injectCriticalCss": true,
      "criticalCssPath": "./themes/consolemonster/critical.css",
      "templateDocsIndex": "./themes/consolemonster/apidocs/docs-index.html",
      "templateDocsType": "./themes/consolemonster/apidocs/docs-type.html",
      "headerHtml": "./_temp/chrome/powershell-commands-header.html",
      "headHtml": "./_temp/chrome/powershell-commands-head.html",
      "footerHtml": "./_temp/chrome/powershell-commands-footer.html"
    },
    {
      "task": "llms",
      "id": "build-llms",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "siteRoot": "./_site",
      "name": "ConsoleMonster",
      "packageId": "ConsoleMonster",
      "project": "../ConsoleMonster/ConsoleMonster.csproj",
      "overview": "ConsoleMonster draws tables, trees, panels, charts and live dashboards for .NET and PowerShell 5.1 and 7. Its core has no package dependencies; the optional Markdown add-on owns Markdown display and export through OfficeIMO.Markdown, and Graphics uses ChartForgeX for image and animation exports.",
      "packageFiles": ["../ConsoleMonster/ConsoleMonster.csproj", "../ConsoleMonster.Markdown/ConsoleMonster.Markdown.csproj", "../ConsoleMonster.Graphics/ConsoleMonster.Graphics.csproj", "../Module/ConsoleMonster.psd1"],
      "apiIndexes": ["./_site/api/index.json", "./_site/powershell/commands/index.json"],
      "discovery": "./config/llms-discovery.md",
      "apiLevel": "summary",
      "apiMaxTypes": 1000,
      "license": "MIT",
      "targets": ".NET Framework 4.7.2, .NET Standard 2.0, .NET 8 and .NET 10; Windows PowerShell 5.1 and PowerShell 7"
    },
    {
      "task": "sitemap",
      "includeTextFiles": false,
      "id": "sitemap",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "baseUrl": "https://consolemonster.dev",
      "json": true,
      "jsonOut": "./_site/sitemap/index.json",
      "excludePatterns": ["frames/**", "replays/**", "recordings/**", "site/**"]
    },
    {
      "task": "agent-ready",
      "id": "prepare-site-discovery",
      "operation": "prepare",
      "dependsOn": ["sitemap", "build-llms"],
      "config": "./site.json",
      "siteRoot": "./_site"
    },
    {
      "task": "verify",
      "id": "verify-dev",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "skipModes": ["ci"],
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "verify",
      "id": "verify-ci",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "modes": ["ci"],
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "seo-doctor",
      "id": "seo-doctor-ci",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "modes": ["ci"],
      "siteRoot": "./_site",
      "baseline": "./.powerforge/seo-baseline.json",
      "failOnNewIssues": true,
      "checkContentLeaks": true,
      "requireCanonical": true,
      "requireStructuredData": true,
      "requireHreflang": false,
      "requireHreflangXDefault": false,
      "reportPath": "./_reports/seo-doctor.json",
      "summaryPath": "./_reports/seo-doctor.md",
      "exclude": "frames/**,replays/**,recordings/**,site/**,404.html,404/**"
    },
    {
      "task": "audit",
      "id": "audit-ci",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "siteRoot": "./_site",
      "modes": ["ci"],
      "summary": true,
      "sarif": true,
      "baseline": "./.powerforge/audit-baseline.json",
      "failOnNewIssues": true,
      "requiredRoutes": "/404.html,/",
      "requireExplicitChecks": true,
      "checkSeoMeta": false,
      "checkNetworkHints": true,
      "checkRenderBlockingResources": true,
      "checkHeadingOrder": true,
      "checkLinkPurposeConsistency": true,
      "checkMediaEmbeds": true,
      "checkAgentContentSecurity": false,
      "rendered": false,
      "exclude": "frames/**,replays/**,recordings/**,site/**"
    },
    {
      "task": "optimize",
      "id": "optimize-site",
      "dependsOn": ["build-site", "build-llms", "build-apidocs", "build-powershell-commands", "sitemap", "prepare-site-discovery", "seo-doctor-ci", "verify-ci", "audit-ci"],
      "modes": ["ci"],
      "siteRoot": "./_site",
      "config": "./site.json",
      "criticalCss": "./themes/consolemonster/critical.css",
      "minifyHtml": true,
      "minifyCss": true,
      "minifyJs": true,
      "hashAssets": true,
      "hashExtensions": [".css", ".js"],
      "hashExclude": ["assets/prism/*.js", "assets/prism/components/**"]
    },
    {
      "task": "verify",
      "id": "verify-optimized-ci",
      "dependsOn": "optimize-site",
      "config": "./site.json",
      "siteRoot": "./_site",
      "modes": ["ci"],
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "audit",
      "id": "audit-optimized-ci",
      "dependsOn": "optimize-site",
      "siteRoot": "./_site",
      "modes": ["ci"],
      "summary": true,
      "sarif": true,
      "baseline": "./.powerforge/audit-baseline.json",
      "failOnNewIssues": true,
      "requiredRoutes": "/404.html,/",
      "requireExplicitChecks": true,
      "checkSeoMeta": false,
      "checkNetworkHints": true,
      "checkRenderBlockingResources": true,
      "checkHeadingOrder": true,
      "checkLinkPurposeConsistency": true,
      "checkMediaEmbeds": true,
      "checkAgentContentSecurity": false,
      "rendered": false,
      "exclude": "frames/**,replays/**,recordings/**,site/**"
    },
    {
      "task": "agent-ready",
      "id": "verify-site-discovery-ci",
      "operation": "verify",
      "dependsOn": "optimize-site",
      "modes": ["ci"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "failOnFailures": true
    }
  ]
}
