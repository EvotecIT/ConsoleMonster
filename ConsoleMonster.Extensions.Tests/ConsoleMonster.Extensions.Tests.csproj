<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>ConsoleMonster.Extensions.Tests</AssemblyName>
        <Description>Tests for the optional ConsoleMonster logging, hosting and Markdown packages.</Description>
        <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster.Extensions.Logging\ConsoleMonster.Extensions.Logging.csproj" />
        <ProjectReference Include="..\ConsoleMonster.Hosting\ConsoleMonster.Hosting.csproj" />
        <ProjectReference Include="..\ConsoleMonster.Markdown\ConsoleMonster.Markdown.csproj" />
        <Compile Include="..\ConsoleMonster.Tests\Rendering\Golden.cs" Link="Rendering\Golden.cs" />
        <None Include="..\ConsoleMonster.Tests\Fixtures\Markdown\everyday.md" Link="Fixtures\everyday.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
