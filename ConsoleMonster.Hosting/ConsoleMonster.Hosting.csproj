<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>ConsoleMonster.Hosting</Title>
        <Description>
            A live ConsoleMonster dashboard for .NET generic host applications: services.AddConsoleDashboard() shows the
            hosted services' state (starting, running, stopped, failed), your own statuses and the log, and stays out of
            the way when the output is redirected or the app runs as a service.
        </Description>
        <AssemblyName>ConsoleMonster.Hosting</AssemblyName>
        <AssemblyTitle>ConsoleMonster.Hosting</AssemblyTitle>
        <RootNamespace>ConsoleMonster.Hosting</RootNamespace>
        <VersionPrefix>2.0.2</VersionPrefix>
        <AssemblyVersion>2.0.2</AssemblyVersion>
        <FileVersion>2.0.2</FileVersion>
        <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <PackageId>ConsoleMonster.Hosting</PackageId>
        <PackageTags>console;terminal;dashboard;hosting;generic-host;ihostedservice;backgroundservice;consolemonster</PackageTags>
        <PackageProjectUrl>https://github.com/EvotecIT/ConsoleMonster</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/EvotecIT/ConsoleMonster</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <DebugType>portable</DebugType>
        <NeutralLanguage>en</NeutralLanguage>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0' ">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ConsoleMonster\ConsoleMonster.csproj" />
        <ProjectReference Include="../ConsoleMonster.Generators/ConsoleMonster.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ConsoleMonster.Extensions.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
